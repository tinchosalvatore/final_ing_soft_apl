# ===================================================================
# Variables de entorno del perfil prod (docs/catedra/12-factors.md §2).
# Copiar a .env (que está en .gitignore) y completar. Este archivo NO lleva valores reales.
#
# Prod real = SPRING_PROFILES_ACTIVE=prod, sin secret-samples. Si falta SPRING_DATASOURCE_URL,
# TRACKER_ADMIN_PASSWORD_HASH o JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET, la app no arranca.
# ===================================================================

SPRING_PROFILES_ACTIVE=prod

# --- Postgres (factor IV) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/trackerGastos
SPRING_DATASOURCE_USERNAME=<usuario>
SPRING_DATASOURCE_PASSWORD=<contraseña>

# --- Seguridad ---
# S6: secreto para firmar los JWT, distinto por entorno. Generarlo con:
#   openssl rand -base64 64 | tr -d '\n'
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=<secreto-base64>

# S5: hash BCrypt de la contraseña de admin (no la contraseña en claro). Generarlo con:
#   htpasswd -bnBC 10 "" '<contraseña>' | tr -d ':\n'
# Se aplica UNA sola vez, en el primer arranque de prod sobre esa base; después se cambia desde la UI.
# Ojo con docker compose: los $ del hash se interpretan como variables. Escribir el valor entre
# comillas simples ('$2y$10$...') o duplicando cada $ ($$2y$$10$$...).
TRACKER_ADMIN_PASSWORD_HASH='<hash-bcrypt>'

# --- Logs (spec 004) ---
JHIPSTER_LOGGING_LOGSTASH_ENABLED=false
JHIPSTER_LOGGING_LOGSTASH_HOST=localhost
JHIPSTER_LOGGING_LOGSTASH_PORT=5000

# --- Puerto HTTP (factor VII), opcional, default 8080 ---
# SERVER_PORT=8080
